{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "UniFi Docs",
  "description": "Build and operate gasless stablecoin payment experiences with UniFi.",
  "colors": {
    "primary": "#155EEF",
    "light": "#26C7E8",
    "dark": "#4B87FF"
  },
  "fonts": {
    "family": "Inter"
  },
  "modeToggle": {
    "default": "light"
  },
  "codeBlock": {
    "mode": "auto"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/unifi-light.svg",
    "dark": "/logo/unifi-dark.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Welcome to UniFi",
            "pages": ["index", "quickstart", "mission"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/how-unifi-works",
              "concepts/security-and-permissions",
              "development"
            ]
          }
        ]
      },
      {
        "tab": "Web app",
        "groups": [
          {
            "group": "Start here",
            "pages": ["webapp/overview", "webapp/home", "webapp/auth"]
          },
          {
            "group": "Wallet",
            "pages": ["webapp/deposit", "webapp/balance"]
          },
          {
            "group": "Payments",
            "pages": [
              "webapp/pay_send",
              "webapp/pay_request",
              "webapp/pay_receipt",
              "webapp/pay_history"
            ]
          },
          {
            "group": "Developer access",
            "pages": ["webapp/api_key", "webapp/api_plan"]
          }
        ]
      },
      {
        "tab": "Build",
        "groups": [
          {
            "group": "Products",
            "pages": ["payment-gateway/overview", "falcon/overview"]
          },
          {
            "group": "Command line",
            "pages": [
              "cli/overview",
              "cli/quickstart",
              "cli/usage",
              "cli/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "/api-reference/openapi.json",
              "directory": "api-reference/endpoints"
            }
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {"label": "Website", "href": "https://payunifi.com"},
      {"label": "Support", "href": "mailto:unifiiweb3@gmail.com"}
    ],
    "primary": {
      "type": "button",
      "label": "Open UniFi",
      "href": "https://unifiweb3.pages.dev/home"
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "website": "https://payunifi.com",
      "linkedin": "https://linkedin.com/company/unifi-web3",
      "x": "https://x.com/abhi3700",
      "github": "https://github.com/abhi3700"
    }
  }
}
